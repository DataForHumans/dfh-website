  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "linkinator": "^8.1.0",
    "typescript": "^6.0.3"
  }
}
