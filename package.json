{
  "name": "dfh-website",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:copy": "node scripts/check-copy.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:links": "linkinator dist --config linkinator.config.json",
    "test:a11y": "playwright test",
