---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import { getTeam, isLive } from '../../lib/content';
import '../../styles/core.css';

const team = await getTeam();
const collider = await getEntry('notes', 'collider-spotlight');
if (!collider?.data.url) throw new Error('About page needs the collider-spotlight note with a url.');
const colliderLive = isLive(collider);

const expertise: Record<string, string> = {
  'chris-roberts': 'Data pipelines and reporting systems',
  'michael-soto': 'Collective impact and public data systems',
  'sean-horan': 'Mathematical modeling and validation',
  'eishna-ranganathan': 'Responsible modeling and data science',
};

const principles = [
  { title: 'Listen to the people doing the work', text: 'We start with conversations because staff know things the data does not capture.' },
  { title: 'Work with the tools you have', text: 'We fit the work to the systems your team already uses, your budget and your capacity.' },
  { title: 'Protect the people behind the data', text: 'When agencies share data, we design around what partners and the public need to see.' },
  { title: 'Leave work your team can use', text: 'We explain the work in plain language and build for the people who will maintain it.' },
];
---

<Base
  title="About"
  description="Data for Humans is a small team that helps mission-driven organizations make sense of their data and of what their people know. Rochester and the Twin Cities, working nationally."
>
  <header class="editorial-frame core-intro about-intro">
    <p class="eyebrow mono">About Data for Humans</p>
    <h1>A small team you work with directly.</h1>
    <p class="lede">We help nonprofits and public agencies make sense of their data and of what their people know. Chris Roberts founded Data for Humans in 2021 to build data capacity in those sectors.</p>
  </header>

  <section class="editorial-frame core-section about-team" aria-labelledby="h-team">
    <h2 id="h-team">Meet the team</h2>
    <ul class="portrait-grid" role="list">
      {team.map((person) => (
        <li id={person.id}>
          {person.data.photo && person.data.photoAlt && (
            <div class="portrait-grid__image">
              <Image class="portrait-grid__photo" src={person.data.photo} alt={person.data.photoAlt} width={480} />
            </div>
          )}
          <div>
            <h3>{person.data.name}{person.data.credentials && <>, {person.data.credentials}</>}</h3>
            <p class="mono portrait-grid__role">{person.data.role}</p>
            {expertise[person.id] && <p class="portrait-grid__expertise">{expertise[person.id]}</p>}
          </div>
          <details>
            <summary>Full bio<span class="visually-hidden"> for {person.data.name}</span></summary>
            {person.data.bio.split(/\n+/).map((paragraph) => <p>{paragraph}</p>)}
            {person.data.linkedin && (
              <a href={person.data.linkedin}>LinkedIn<span class="visually-hidden"> for {person.data.name}</span></a>
            )}
          </details>
        </li>
      ))}
    </ul>
  </section>

  <section class="editorial-frame core-section about-method" aria-labelledby="h-how">
    <h2 id="h-how">How we work</h2>
    <ul role="list">
      {principles.map((principle) => (
        <li>
          <h3>{principle.title}</h3>
          <p>{principle.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="editorial-frame core-section about-roots" aria-labelledby="h-roots">
    <div>
      <h2 id="h-roots">Minnesota roots, national reach</h2>
      <p>Our roots are in local government and nonprofit work in Rochester and the Twin Cities. We work nationally, remotely by default and on site when the project calls for it.</p>
      <Button href="/contact/">Contact the team</Button>
    </div>
    <div>
      <h3 id="h-news">In the news</h3>
      <p>
        Collider: <a href={collider.data.url}
          >“Putting Data to Work for Good: How Chris Roberts Is Helping Nonprofits Make a Bigger Impact,”</a
        > Nov 9, 2026.{colliderLive && <> <a href={`/notes/${collider.id}/`}>Our note</a>.</>}
      </p>
    </div>
  </section>
</Base>
