---
import NetworkAccent from '../../components/NetworkAccent.astro';
import Base from '../../layouts/Base.astro';
import ConnectionMapSample from '../../components/ConnectionMapSample.astro';
import Button from '../../components/Button.astro';
import { SERVICE_SLUGS } from '../../content.config';
import { BOOKING_URL, CONNECTION_MAP, PRODUCTS, SERVICE_NAMES } from '../../data/site';
import '../../styles/core.css';

const { donorOverlap, footprintReview } = PRODUCTS;
const [, ...capabilities] = SERVICE_SLUGS;

const weeks = [
  { title: 'Listen', text: 'We talk with four to six people about your mission, what staff know, and the processes and systems they use.' },
  { title: 'Map', text: 'We trace how information moves and where systems or processes remain disconnected.' },
  { title: 'Connect', text: 'We identify ways to bring information together, answer important questions, and reduce extra work.' },
  { title: 'Plan', text: 'We prioritize improvements and walk leadership or the board through a practical data strategy you own.' },
];

const offerings = {
  'collective-impact-dashboards': {
    text: 'When several agencies share a goal, they should be able to see their progress together. We build live dashboards that partners and the public can understand, and help agencies agree on what to share and how to keep it current.',
    link: { href: '/work/#any-path-home', label: 'See the Any Path Home project' },
  },
  'records-integration': {
    text: 'If your staff have to make the same records agree across several systems, we clean and match those records, connect systems where we can, and automate recurring reports.',
    link: { href: '/work/#crowded-closet', label: 'See the Crowded Closet project' },
  },
  'research-evaluation': {
    text: 'Find out who your program is reaching and where it could serve people better. We analyze records, use interviews and surveys, and map how teams or coalitions work. We explain what we found, how we found it and where the evidence is limited.',
    link: undefined,
  },
  'ai-policy-training': {
    text: 'If your team is trying AI, we help you decide where it can save time, what information should stay private, and where staff judgment matters. We help write a plain-language policy, train staff and set up one tool at a time.',
    link: { href: '/events/', label: 'See talks and events' },
  },
  'data-leadership': {
    text: "When decisions about data keep coming up and a full-time senior hire is out of reach, we can serve as your data lead a few days a month.",
    link: undefined,
  },
} satisfies Record<(typeof capabilities)[number], { text: string; link?: { href: string; label: string } }>;
---

<Base title="Services" description="Get help with reporting, dashboards, records, evaluation and AI. Start with the Connection Map, our four-week data strategy engagement, or bring us a specific project.">
  <header class="editorial-frame core-intro services-intro">
    <div>
      <h1>Data help for the work you do</h1>
      <p class="lede">Maybe reporting takes too much staff time, or your partners can’t see their progress together. Bring us the problem you’re trying to solve. Most engagements start with a four-week data strategy.</p>
    </div>
    <NetworkAccent variant="threads" placement="services-intro" />
    <nav class="core-index" aria-label="On this page">
      <ul role="list">
        <li><a class="services-intro__flagship" href={`#${CONNECTION_MAP.anchor}`}>{CONNECTION_MAP.name} <span aria-hidden="true">↓</span></a></li>
        {capabilities.map((slug) => (
          <li><a href={`#${slug}`}>{SERVICE_NAMES[slug]} <span aria-hidden="true">↓</span></a></li>
        ))}
      </ul>
    </nav>
  </header>

  <section class="editorial-frame core-section roadmap" id={CONNECTION_MAP.anchor} aria-labelledby="h-connection-map">
    <span id="data-roadmap" class="legacy-service-anchor" aria-hidden="true"></span>
    <NetworkAccent variant="drift" placement="roadmap" />
    <div class="roadmap__heading">
      <h2 id="h-connection-map">{CONNECTION_MAP.name}</h2>
      <p class="lede">{CONNECTION_MAP.subtitle}</p>
      <p>Find where your systems create extra work and decide what’s worth fixing first. The engagement has a fixed fee and scope. You own the strategy and can hand it to your team or any vendor, with no obligation to continue.</p>
    </div>
    <ConnectionMapSample />
    <div class="roadmap__method">
      <h3>How the four weeks work</h3>
      <ol class="roadmap__weeks">
        {weeks.map(({ title, text }, index) => (
          <li><span class="mono">Week {index + 1}</span> <strong>{title}.</strong> {text}</li>
        ))}
      </ol>
    </div>
    <div class="roadmap__readout">
      <div>
        <h3>What you receive</h3>
        <ul>
          <li>A map of how your data systems work today</li>
          <li>A list of possible improvements ranked by effort and expected benefit</li>
          <li>A written implementation sequence explaining what to do first and why</li>
          <li>A walkthrough for leadership or the board</li>
        </ul>
      </div>
      <div>
        <h3>Scope</h3>
        <p>One organization, up to six interviews, and up to three source systems examined in depth. We quote larger engagements separately.</p>
        <Button href={BOOKING_URL} primary>Talk through your data strategy</Button>
      </div>
    </div>
  </section>

  <section class="editorial-frame core-section capability-section" aria-labelledby="h-after">
    <div class="core-section__lead">
      <h2 id="h-after">Capabilities</h2>
      <p>You can also come to us for any of these directly.</p>
    </div>
    <ul class="capability-list" role="list">
      {capabilities.map((slug) => {
        const { text, link } = offerings[slug];
        return (
          <li id={slug}>
            <h3>{SERVICE_NAMES[slug]}</h3>
            <p>{text}</p>
            {link && <a href={link.href}>{link.label}</a>}
          </li>
        );
      })}
    </ul>
  </section>

  <section class="editorial-frame core-section" id="products" aria-labelledby="h-products">
    <h2 id="h-products">Products from our practice</h2>
    <ul class="core-columns product-list" role="list">
      <li>
        <h3>Donor Overlap</h3>
        <p>Links donor, volunteer and event records so you can see who gives time, money or both.</p>
        <p>{donorOverlap.live ? <a href={donorOverlap.url}>{donorOverlap.domain}</a> : donorOverlap.domain}</p>
      </li>
      <li>
        <h3>Footprint Review</h3>
        <p>Gathers what your organization knows and has achieved, from staff interviews and the documents you already have, so you can find it and tell your story.</p>
        <p>{footprintReview.live ? <a href={footprintReview.url}>{footprintReview.name}</a> : footprintReview.name}</p>
      </li>
      <li>
        <h3>Parcelwise</h3>
        <p>Scores every parcel in a city or county against zoning, land value and vacancy data, for economic development teams. In development; <a href="/contact/">ask us about early access</a>.</p>
      </li>
    </ul>
  </section>
</Base>
