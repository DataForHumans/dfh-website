---
import NetworkAccent from '../../components/NetworkAccent.astro';
import Base from '../../layouts/Base.astro';
import RoadmapSample from '../../components/RoadmapSample.astro';
import Button from '../../components/Button.astro';
import { SERVICE_SLUGS } from '../../content.config';
import { BOOKING_URL, PRODUCTS, SERVICE_NAMES } from '../../data/site';
import '../../styles/core.css';

const { donorOverlap, footprintReview } = PRODUCTS;
const [, ...capabilities] = SERVICE_SLUGS;

const weeks = [
  { title: 'Inventory', text: 'Interview four to six people and catalog the systems, exports and spreadsheets they use.' },
  { title: 'Diagnosis', text: 'Find where data breaks down, where reporting takes manual work and which questions the data cannot yet answer.' },
  { title: 'Opportunity mapping', text: 'Sort quick wins, build-outs and foundational work by effort and expected value.' },
  { title: 'The handoff', text: 'Deliver the written roadmap and walk through it with leadership or the board.' },
];

const offerings = {
  'collective-impact-dashboards': {
    text: 'When several agencies work toward one goal, we build a live dashboard their partners and the public can read. We help establish agreements and a governed way for each agency to contribute and keep it current.',
    link: { href: '/work/#any-path-home', label: 'See the Any Path Home project' },
  },
  'records-integration': {
    text: 'When the same person shows up in several systems or staff copy records by hand, we match and clean records, connect systems where we can, and automate recurring reports.',
    link: { href: '/work/#crowded-closet', label: 'See the Crowded Closet project' },
  },
  'research-evaluation': {
    text: 'When funders or boards need answers, we analyze program records, run interviews and surveys, and map how a coalition or team works. We write the findings and methods for the people who will use them.',
    link: undefined,
  },
  'ai-policy-training': {
    text: 'When staff already use AI and need guidance on what data is safe to share, we help decide where AI fits, write a plain-language use policy, train the team, and set up one tool at a time for a slow process.',
    link: { href: '/events/', label: 'See talks and events' },
  },
  'data-leadership': {
    text: "When data should guide how you operate but a full-time senior hire isn't realistic, we can serve as your data lead a few days a month.",
    link: undefined,
  },
} satisfies Record<(typeof capabilities)[number], { text: string; link?: { href: string; label: string } }>;
---

<Base title="Services" description="Every engagement starts with a plan: a four-week Data Roadmap. Then dashboards, records and integration, research and evaluation, AI policy and training, and part-time data leadership.">
  <header class="editorial-frame core-intro services-intro">
    <div>
      <p class="eyebrow mono">Services</p>
      <h1>From better questions to better systems</h1>
      <p class="lede">Nearly every engagement begins with a four-week Data Roadmap. We tailor the work to your budget, tools and team.</p>
    </div>
    <NetworkAccent variant="threads" placement="services-intro" />
    <nav class="core-index" aria-label="On this page">
      <ul role="list">
        <li><a href="#data-roadmap">The Data Roadmap <span aria-hidden="true">↓</span></a></li>
        {capabilities.map((slug) => (
          <li><a href={`#${slug}`}>{SERVICE_NAMES[slug]} <span aria-hidden="true">↓</span></a></li>
        ))}
      </ul>
    </nav>
  </header>

  <section class="editorial-frame core-section roadmap" id="data-roadmap" aria-labelledby="h-roadmap">
    <div class="roadmap__heading">
      <h2 id="h-roadmap">The Data Roadmap</h2>
      <p>Four weeks, fixed fee and scope. You own the plan and can hand it to your team or any vendor, with no obligation to continue.</p>
    </div>
    <ol class="roadmap__weeks" role="list">
      {weeks.map((week, index) => (
        <li>
          <p class="mono">Week {index + 1}</p>
          <h3>{week.title}</h3>
          <p>{week.text}</p>
        </li>
      ))}
    </ol>
    <RoadmapSample />
    <div class="roadmap__readout">
      <div>
        <h3>What you receive</h3>
        <ul>
          <li>A map of how your data systems work today</li>
          <li>A list of opportunities sized by effort and value</li>
          <li>A written roadmap explaining what to do first and why</li>
          <li>A walkthrough for leadership or the board</li>
        </ul>
      </div>
      <div>
        <h3>Scope</h3>
        <p>One organization, up to six interviews, and up to three source systems examined in depth. We quote larger engagements separately.</p>
        <Button href={BOOKING_URL} primary>Talk through a roadmap</Button>
      </div>
    </div>
  </section>

  <section class="editorial-frame core-section capability-section" aria-labelledby="h-after">
    <div class="core-section__lead">
      <h2 id="h-after">Capabilities</h2>
      <p>You can also come to us for any of these directly.</p>
    </div>
    <ul class="capability-list" role="list">
      {capabilities.map((slug) => {
        const { text, link } = offerings[slug];
        return (
          <li id={slug}>
            <h3>{SERVICE_NAMES[slug]}</h3>
            <p>{text}</p>
            {link && <a href={link.href}>{link.label}</a>}
          </li>
        );
      })}
    </ul>
  </section>

  <section class="editorial-frame core-section" id="products" aria-labelledby="h-products">
    <h2 id="h-products">Products from our practice</h2>
    <ul class="core-columns product-list" role="list">
      <li>
        <h3>Donor Overlap</h3>
        <p>Links donor, volunteer and event records so you can see who gives time, money or both.</p>
        <p>{donorOverlap.live ? <a href={donorOverlap.url}>{donorOverlap.domain}</a> : donorOverlap.domain}</p>
      </li>
      <li>
        <h3>Footprint Review</h3>
        <p>Gathers what your organization knows and has achieved, from staff interviews and the documents you already have, so you can find it and tell your story.</p>
        <p>{footprintReview.live ? <a href={footprintReview.url}>{footprintReview.domain}</a> : footprintReview.domain}</p>
      </li>
      <li>
        <h3>Parcelwise</h3>
        <p>Scores every parcel in a city or county against zoning, land value and vacancy data, for economic development teams. In development; <a href="/contact/">ask us about early access</a>.</p>
      </li>
    </ul>
  </section>
</Base>
