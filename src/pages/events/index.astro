---
import Base from '../../layouts/Base.astro';
import SupportHeader from '../../components/SupportHeader.astro';
import EventItem from '../../components/EventItem.astro';
import { getPastEvents, getUpcomingEvents } from '../../lib/content';

const upcoming = await getUpcomingEvents();
const past = await getPastEvents();
const sections = [
  { id: 'h-upcoming', title: 'Upcoming events', events: upcoming },
  { id: 'h-past', title: 'Past events', events: past },
];
---

<Base accent="threads" title="Talks and events" description="Find upcoming workshops and talks about data and AI for nonprofits and public agencies.">
  <SupportHeader title="Talks and events">
    <p class="lede">Join us for talks and working sessions on questions your team faces about data and AI.</p>
  </SupportHeader>

  <div class="editorial-frame events-page">
    {sections.filter(({ id, events }) => id === 'h-upcoming' || events.length > 0).map(({ id, title, events }) => (
      <section aria-labelledby={id}>
        <h2 id={id}>{title}</h2>
        {events.length > 0 ? (
          <ul class="entry-list" role="list">
            {events.map((event) => <li><EventItem event={event} headingLevel={3} /></li>)}
          </ul>
        ) : (
          <p class="events-page__empty">No upcoming events are scheduled.</p>
        )}
      </section>
    ))}
    <p class="events-page__invitation"><a href="/contact/">Get in touch about hosting a talk or workshop</a></p>
  </div>
</Base>
