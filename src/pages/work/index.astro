---
import Button from '../../components/Button.astro';
import PublicDashboard from '../../components/PublicDashboard.astro';
import VolunteerAgeChart from '../../components/VolunteerAgeChart.astro';
import { render } from 'astro:content';
import NetworkAccent from '../../components/NetworkAccent.astro';
import Base from '../../layouts/Base.astro';
import { getWork, workAnchor, workLink } from '../../lib/content';
import '../../styles/core.css';

const headlines: Record<string, string> = {
  'any-path-home': 'A shared view of homelessness',
  'crowded-closet': 'Volunteer records sharpen recruitment',
};

const entries = await Promise.all(
  (await getWork()).map(async (entry) => ({
    entry,
    headline: headlines[entry.id],
    Content: (await render(entry)).Content,
    link: await workLink(entry),
  })),
);
---

<Base
  title="Our work"
  description="See how a housing coalition and a nonprofit thrift shop used the records they already kept to make decisions."
>
  <header class="editorial-frame core-intro work-intro">
    <NetworkAccent variant="bridge" placement="work" />
    <div>
      <h1>Our work</h1>
      <p class="lede">See what teams working on housing and volunteer recruitment could learn from the records they already kept.</p>
    </div>
    <nav class="core-index" aria-label="Jump to a project">
      <ul role="list">
        {entries.map(({ entry }) => (
          <li><a href={`#${workAnchor(entry)}`}>{entry.data.title} <span aria-hidden="true">↓</span></a></li>
        ))}
      </ul>
    </nav>
  </header>

  {entries.map(({ entry, headline, Content, link }) => (
    <section class:list={['editorial-frame core-section case-study', { 'case-study--alternate': entry.id === 'crowded-closet' }]} id={workAnchor(entry)} aria-labelledby={`h-${entry.id}`}>
      <div class="case-study__header">
        <p class="entry__meta">{entry.data.service + ' · ' + entry.data.sector}</p>
        <h2 id={`h-${entry.id}`}>{headline ?? entry.data.title}</h2>
        {headline && <p class="case-study__client">{entry.data.title}</p>}
      </div>
      <div class="case-study__body">
        {headline && (
          <div class="case-study__evidence">
            {entry.id === 'any-path-home' && <PublicDashboard />}
            {entry.id === 'crowded-closet' && <VolunteerAgeChart analysisHref={link} />}
          </div>
        )}
        <div class="case-study__story">
          <Content />
          {link && entry.id !== 'crowded-closet' && <a class="case-study__link" href={link}>{entry.data.linkLabel}</a>}
        </div>
      </div>
      {entry.data.quote && (
        <figure class="case-quote">
          <blockquote><p>“{entry.data.quote}”</p></blockquote>
          <figcaption>{entry.data.quoteSource}</figcaption>
        </figure>
      )}
    </section>
  ))}
  <section class="editorial-frame core-section work-contact" aria-labelledby="work-contact-heading">
    <h2 id="work-contact-heading">Bring us a challenge your team is facing</h2>
    <Button href="/contact/">Contact the team</Button>
  </section>
</Base>
