---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import { BOOKING_URL, EMAILS } from '../../data/site';
---

<Base
  title="Contact"
  description="Start with a free conversation. Tell us where your data is getting in the way, and we'll suggest a sensible next step."
>
  <PageHeader title="Contact">
    <p class="lede">
      Start with a free conversation. Tell us where your data is getting in the way, and we'll suggest a sensible next
      step, whether or not that's working with us.
    </p>
  </PageHeader>

  <Section num={1} label="Call" labelledby="h-book">
    <h2 id="h-book">Book a free 30-minute call.</h2>
    <p>No prep needed.</p>
    <p class="actions">
      <Button href={BOOKING_URL} primary>Book a time</Button>
    </p>
  </Section>

  <Section num={2} label="Message" labelledby="h-form">
    <h2 id="h-form">Send a message</h2>
    <form
      class="form"
      name="contact"
      method="POST"
      action="/contact/thanks/"
      data-netlify="true"
      netlify-honeypot="company-website"
    >
      <input type="hidden" name="form-name" value="contact" />
      <!-- Honeypot: hidden from everyone. Netlify drops submissions that fill it in. -->
      <p hidden>
        <label>Leave this field empty <input name="company-website" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required data-error="Enter your name." />
        <p class="field__error" id="name-error" hidden></p>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          data-error="Enter your email address, like name@example.org."
        />
        <p class="field__error" id="email-error" hidden></p>
      </div>
      <div class="field">
        <label for="organization">Organization <span class="field__optional">(optional)</span></label>
        <input id="organization" name="organization" type="text" autocomplete="organization" />
      </div>
      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="7" required data-error="Enter a message."></textarea>
        <p class="field__error" id="message-error" hidden></p>
      </div>
      <button class="button" type="submit">Send message</button>
    </form>
  </Section>

  <script>
    // Inline error text for the contact form. Without JavaScript the browser's
    // own validation still runs; with it, each error is written next to its
    // field, tied to it with aria-describedby, and focus moves to the first one.
    const form = document.querySelector<HTMLFormElement>('form[name="contact"]');
    if (form) {
      form.noValidate = true;
      const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-error]')];

      const show = (field: HTMLInputElement | HTMLTextAreaElement) => {
        const error = document.getElementById(`${field.id}-error`);
        if (!error) return;
        const valid = field.checkValidity();
        error.textContent = valid ? '' : (field.dataset.error ?? '');
        error.hidden = valid;
        if (valid) {
          field.removeAttribute('aria-invalid');
          field.removeAttribute('aria-describedby');
        } else {
          field.setAttribute('aria-invalid', 'true');
          field.setAttribute('aria-describedby', error.id);
        }
        return valid;
      };

      form.addEventListener('submit', (event) => {
        const invalid = fields.filter((f) => !show(f));
        if (invalid.length > 0) {
          event.preventDefault();
          invalid[0].focus();
        }
      });

      // Clear an error as soon as the field is fixed.
      for (const field of fields) {
        field.addEventListener('input', () => {
          if (field.getAttribute('aria-invalid') === 'true') show(field);
        });
      }
    }
  </script>

  <Section num={3} label="Email" labelledby="h-email">
    <h2 id="h-email" class="visually-hidden">Email</h2>
    <ul class="plain-list" role="list">
      {EMAILS.map((e) => <li><a href={`mailto:${e}`}>{e}</a></li>)}
    </ul>
  </Section>

  <Section num={4} label="Where" labelledby="h-where">
    <h2 id="h-where">Where we are</h2>
    <p>
      Rochester and the Twin Cities. We work with mission-driven organizations across Minnesota and beyond, mostly
      remotely.
    </p>
  </Section>
</Base>
