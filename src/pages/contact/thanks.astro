---
// Netlify Forms sends people here after a successful submission.
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import SupportHeader from '../../components/SupportHeader.astro';
---

<Base title="Thanks" description="Thanks for reaching out. We'll reply within one business day." noindex>
  <SupportHeader title="Thanks for reaching out.">
    <p class="lede">Your message was submitted. We'll reply within one business day.</p>
    <p class="support-actions"><Button href="/">Back to the home page</Button></p>
  </SupportHeader>
</Base>
