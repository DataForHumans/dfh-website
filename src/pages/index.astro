---
import Base from '../layouts/Base.astro';
import NetworkAccent from '../components/NetworkAccent.astro';
import CapabilityIcon from '../components/CapabilityIcon.astro';
import Button from '../components/Button.astro';
import PublicDashboard from '../components/PublicDashboard.astro';
import VolunteerAgeChart from '../components/VolunteerAgeChart.astro';
import SystemsGraphic from '../components/SystemsGraphic.astro';
import { SERVICE_SLUGS } from '../content.config';
import { BOOKING_URL, SERVICE_NAMES, TAGLINE, SITE_NAME } from '../data/site';
import { getUpcomingEvents, getWork, outcomeOf, workAnchor, workLink } from '../lib/content';
import { formatDate, isoDate } from '../lib/dates';

const [nextEvent] = await getUpcomingEvents();
const [roadmapSlug, ...capabilities] = SERVICE_SLUGS;

const projectCopy: Record<string, { headline: string; summary: string }> = {
  'any-path-home': {
    headline: 'One view of progress on homelessness',
    summary: 'A public dashboard brings agency data together while keeping individual records out of public view.',
  },
  'crowded-closet': {
    headline: 'Volunteer records sharpen recruitment',
    summary: 'The analysis helped the shop focus recruiting on older volunteers, who provided much of its steady service.',
  },
};

const projects = await Promise.all(
  (await getWork(true)).map(async (entry) => ({
    entry,
    copy: projectCopy[entry.id],
    link: await workLink(entry),
  })),
);

const figures = [
  { value: '85+', label: "Organizations' data brought together" },
  { value: '30+', label: 'Years of combined experience' },
  { value: '4', unit: 'weeks', label: 'To a focused data roadmap' },
];
---

<Base title={SITE_NAME} description={`${TAGLINE}. We help nonprofits, public agencies and cities make better decisions with the records they already keep.`}>
  <header class="editorial-frame editorial-grid home-hero">
    <div class="home-hero__copy">
      <h1><span class="home-hero__statement">Your mission runs on data.</span> <em>Let's make it work for you.</em></h1>
      <p class="lede">
        We help nonprofits, public agencies and cities make better decisions with the records they already keep, without
        hiring a full-time data team.
      </p>
      <p class="actions">
        <Button href={BOOKING_URL} primary>Book a free call</Button>
        <Button href="/work/">See our work</Button>
      </p>
    </div>
    <SystemsGraphic />
  </header>

  <section class="figures" aria-label="Key figures">
    <NetworkAccent variant="drift" placement="metrics" />
    <dl class="editorial-frame figures__list">
      {figures.map((figure) => (
        <div class="figures__item">
          <dt class="mono figures__value">{figure.value}{figure.unit && <> <span class="figures__unit">{figure.unit}</span></>}</dt>
          <dd class="figures__label">{figure.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="editorial-frame home-section selected-work" aria-labelledby="h-work">
    <NetworkAccent variant="threads" placement="selected-work" />
    <div class="home-section__heading">
      <h2 id="h-work">Selected work</h2>
      <a href="/work/">View all work <span aria-hidden="true">↗</span></a>
    </div>
    <ul class="selected-work__list" role="list">
      {projects.map(({ entry, copy, link }) => (
        <li class="selected-work__item">
          {(entry.id === 'any-path-home' || entry.id === 'crowded-closet') && (
            <div class="selected-work__visual">
              {entry.id === 'any-path-home' ? <PublicDashboard preview /> : <VolunteerAgeChart preview analysisHref={link} />}
            </div>
          )}
          <div class="selected-work__copy">
            <h3><a href={`/work/#${workAnchor(entry)}`}><span>{copy?.headline ?? entry.data.title}</span><span aria-hidden="true">↗</span></a></h3>
            {copy && <p class="selected-work__client">{entry.data.title}</p>}
            <p>{copy?.summary ?? outcomeOf(entry)}</p>
            {link?.startsWith('https://') && <a class="selected-work__source" href={link}>{entry.data.linkLabel}</a>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="editorial-frame editorial-grid home-section home-services" aria-labelledby="h-services">
    <NetworkAccent variant="drift" placement="sage-panel" />
    <div>
      <p class="home-services__label">The Data Roadmap</p>
      <h2 id="h-services">Know what to fix first</h2>
      <p>
        In four weeks, for a fixed fee, we map your systems and give you a prioritized plan.
        The plan is yours to use with any team.
      </p>
      <Button href={`/services/#${roadmapSlug}`}>Explore the Roadmap</Button>
    </div>
    <div class="home-services__capabilities">
      <h3>Our capabilities</h3>
      <ul role="list">
        {capabilities.map((slug) => (
          <li><a href={`/services/#${slug}`}><CapabilityIcon service={slug} /><span>{SERVICE_NAMES[slug]}</span><span aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  {nextEvent && (
    <aside class="editorial-frame home-event" aria-label="Upcoming event">
      <div>
        <p class="mono">Upcoming event · <time datetime={isoDate(nextEvent.data.date)}>{formatDate(nextEvent.data.date)}</time> · {nextEvent.data.time}</p>
        <p>{nextEvent.data.title}</p>
      </div>
      <a href="/events/">Event details <span aria-hidden="true">↗</span></a>
    </aside>
  )}

  <NetworkAccent variant="fragment" placement="closing" />
  <section class="editorial-frame home-section home-contact" aria-labelledby="h-closing">
    <div>
      <h2 id="h-closing">Start with a free 30-minute call</h2>
      <p>You'll leave with a suggested next step, whether or not you hire us.</p>
    </div>
    <p class="actions">
      <Button href={BOOKING_URL} primary>Book a free call</Button>
      <Button href="/contact/">Send a message</Button>
    </p>
  </section>
</Base>
