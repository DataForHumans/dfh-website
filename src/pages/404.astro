---
import Base from '../layouts/Base.astro';
import SupportHeader from '../components/SupportHeader.astro';
---

<Base accent="drift" title="Page not found" description="Find your way back to Services, Notes or Contact." noindex>
  <SupportHeader title="Page not found">
    <p class="lede">The page you’re looking for may have moved. You can find our services, read our notes or get in touch below.</p>
    <ul class="support-actions plain-list" role="list">
      <li><a href="/services/">Services</a></li>
      <li><a href="/notes/">Notes</a></li>
      <li><a href="/contact/">Contact</a></li>
    </ul>
  </SupportHeader>
</Base>
