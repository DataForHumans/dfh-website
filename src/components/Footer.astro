---
import { FOOTER_LINE, LINKEDIN_URL, PRODUCTS, RELAYERED_URL, SITE_NAME, TAGLINE } from '../data/site';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__name">{SITE_NAME}</p>
    <p class="site-footer__tagline">{TAGLINE}</p>
    <p class="site-footer__line">{FOOTER_LINE}</p>
    <nav aria-label="Footer">
      <ul class="site-footer__links">
        {
          LINKEDIN_URL && (
            <li>
              <a href={LINKEDIN_URL} rel="me">LinkedIn</a>
            </li>
          )
        }
        <li><a href="/events/">Talks and events</a></li>
        <li><a href="/notes/rss.xml">RSS</a></li>
        <li>Fabrication:&nbsp;<a href={RELAYERED_URL}>Relayered Design</a></li>
        {
          PRODUCTS.map((p) => (
            <li>
              <a href={p.url}>{p.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
