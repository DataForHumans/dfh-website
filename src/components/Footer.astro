---
import { FOOTER_LINE, LINKEDIN_URL, PRODUCTS, RELAYERED, SITE_NAME, TAGLINE } from '../data/site';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__name">{SITE_NAME}</p>
    <p class="site-footer__tagline">{TAGLINE}</p>
    <p class="site-footer__line">{FOOTER_LINE}</p>
    <nav aria-label="Footer">
      <ul class="site-footer__links">
        {
          LINKEDIN_URL && (
            <li>
              <a href={LINKEDIN_URL} rel="me">LinkedIn</a>
            </li>
          )
        }
        <li><a href="/events/">Talks and events</a></li>
        <li><a href="/notes/rss.xml">RSS</a></li>
        <li>Fabrication:&nbsp;{RELAYERED.live ? <a href={RELAYERED.url}>{RELAYERED.name}</a> : RELAYERED.name}</li>
        {
          Object.values(PRODUCTS).map((p) => <li>{p.live ? <a href={p.url}>{p.name}</a> : p.name}</li>)
        }
      </ul>
    </nav>
  </div>
</footer>
