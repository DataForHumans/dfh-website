---
interface Props {
  variant: 'threads' | 'fragment' | 'drift' | 'bridge' | 'connected' | 'arc';
  placement: 'heading' | 'article' | 'services-intro' | 'footer' | 'home-field' | 'feature' | 'roadmap' | 'manifesto' | 'work' | 'contact';
}

const { variant, placement } = Astro.props;
const viewBoxHeight = { connected: 450, arc: 440, drift: 148, bridge: 205, threads: 205, fragment: 205 }[variant];
const wide = variant === 'connected' || variant === 'arc';
---
<span class:list={['network-accent', `network-accent--${placement}`]} data-network-accent aria-hidden="true">
  <svg viewBox={`0 0 ${wide ? 660 : 360} ${viewBoxHeight}`} focusable="false" aria-hidden="true">
    {variant === 'connected' ? (
      <>
        <path class="edges edges--wide" d="M52 254Q112 300 180 227T319 186Q392 225 474 170T695 110M180 227Q166 170 111 144M319 186Q328 123 383 111T492 113Q590 89 702 18M474 170Q530 236 582 260T703 254M582 260C626 316 561 348 603 398S671 425 716 447M603 398Q659 387 702 349M582 260Q644 280 705 215M474 170Q507 126 563 138T698 136" />
        <circle cx="52" cy="254" r="5" class="ring" />
        <circle cx="111" cy="144" r="7" class="blue" />
        <circle cx="180" cy="227" r="10" class="sage" />
        <circle cx="319" cy="186" r="8" class="ring" />
        <circle cx="383" cy="111" r="7" class="blue" />
        <circle cx="492" cy="113" r="7" class="ring" />
        <circle cx="474" cy="170" r="10" class="sage" />
        <circle cx="563" cy="138" r="16" class="ochre" />
        <circle cx="582" cy="260" r="10" class="sage" />
        <circle cx="603" cy="398" r="8" class="blue" />
      </>
    ) : variant === 'arc' ? (
      <>
        <path class="edges edges--wide" d="M52 298Q117 348 176 274T314 232Q390 280 434 212T559 140Q633 148 702 100M176 274Q173 217 112 184M314 232Q270 152 327 109T466 109M327 109Q305 79 278 56M434 212Q468 290 536 288T704 237M536 288Q510 345 563 377T708 381M559 140Q607 194 703 178" />
        <circle cx="52" cy="298" r="5" class="ring" />
        <circle cx="112" cy="184" r="7" class="blue" />
        <circle cx="176" cy="274" r="10" class="sage" />
        <circle cx="314" cy="232" r="11" class="sage" />
        <circle cx="327" cy="109" r="8" class="ring" />
        <circle cx="278" cy="56" r="6" class="blue" />
        <circle cx="466" cy="109" r="18" class="ochre" />
        <circle cx="434" cy="212" r="7" class="ring" />
        <circle cx="559" cy="140" r="10" class="sage" />
        <circle cx="536" cy="288" r="8" class="blue" />
        <circle cx="563" cy="377" r="7" class="sage" />
      </>
    ) : variant === 'drift' ? (
      <>
        <path class="edges" d="M36 98C97 105 128 34 192 48C215 53 231 65 253 74S313 92 359 75Q390 64 407 39M192 48Q243 2 292 24T401 18M253 74C275 104 288 129 319 123S369 105 401 129M192 48Q168 71 162 92" />
        <circle cx="36" cy="98" r="3" class="ring" />
        <circle cx="162" cy="92" r="3.3" class="blue" />
        <circle cx="192" cy="48" r="6" class="sage" />
        <circle cx="292" cy="24" r="4" class="ring" />
        <circle cx="319" cy="123" r="4.8" class="blue" />
        <circle cx="359" cy="75" r="5.3" class="ochre" />
      </>
    ) : variant === 'bridge' ? (
      <>
        <path class="edges" d="M29 116Q55 130 78 105L121 121 109 155 67 160 78 105 106 63 146 79 121 121M121 121C171 140 187 60 244 85s67 37 113 16l38-18M244 85l35-43 39 14 24-35 48 6m-72 29 9 63-53 21-30-55m83 34 30-18m-30 18q-5 32 18 42t53 13M318 56q32-3 73 13" />
        <circle cx="29" cy="116" r="2.8" class="ring" />
        <circle cx="78" cy="105" r="5.5" class="sage" />
        <circle cx="121" cy="121" r="5" class="ochre" />
        <circle cx="109" cy="155" r="3.7" class="blue" />
        <circle cx="67" cy="160" r="2.7" class="ring" />
        <circle cx="106" cy="63" r="3" class="blue" />
        <circle cx="146" cy="79" r="3.5" class="ring" />
        <circle cx="244" cy="85" r="6" class="sage" />
        <circle cx="318" cy="56" r="5" class="blue" />
        <circle cx="274" cy="140" r="4" class="ring" />
        <circle cx="327" cy="119" r="3.7" class="sage" />
        <circle cx="279" cy="42" r="4.5" class="ring" />
        <circle cx="342" cy="21" r="2.8" class="ring" />
        <circle cx="357" cy="101" r="5" class="sage" />
        <circle cx="345" cy="161" r="3" class="blue" />
      </>
    ) : variant === 'threads' ? (
      <>
        <path class="edges" d="M23 164C58 169 78 128 117 142S192 183 245 121 326 32 360 40Q386 42 400 30M117 142C149 111 156 50 204 47S253 88 288 67Q309 55 322 26T391 5M245 121C298 101 331 145 377 119l23-13M288 67Q307 100 337 88t63-9" />
        <circle cx="23" cy="164" r="2.8" class="ring" />
        <circle cx="204" cy="47" r="4.8" class="blue" />
        <circle cx="245" cy="121" r="5.8" class="sage" />
        <circle cx="288" cy="67" r="3.8" class="ring" />
        <circle cx="117" cy="142" r="4.5" class="ochre" />
        <circle cx="322" cy="26" r="4" class="ring" />
        <circle cx="360" cy="40" r="5" class="sage" />
        <circle cx="337" cy="88" r="3.2" class="blue" />
      </>
    ) : (
      <>
        <path class="edges" d="M31 151Q100 180 146 150T230 95Q263 42 352 20l50-5M146 150l31-50 53-5-27 69-57-14m31-50 42-40 11 35 53 18 24-45-46-14m22 59 53 21 31-36 38 6m-98-36 45-48m-16 114q-19 42 27 49t45-5M203 164C240 201 323 198 374 163l30-12" />
        <circle cx="31" cy="151" r="3" class="ring" />
        <circle cx="146" cy="150" r="4.2" class="sage" />
        <circle cx="177" cy="100" r="3" class="ring" />
        <circle cx="230" cy="95" r="6" class="sage" />
        <circle cx="203" cy="164" r="3" class="blue" />
        <circle cx="219" cy="60" r="3.5" class="blue" />
        <circle cx="283" cy="113" r="4.7" class="sage" />
        <circle cx="307" cy="68" r="2.8" class="ring" />
        <circle cx="336" cy="134" r="3.8" class="ring" />
        <circle cx="261" cy="54" r="4.5" class="blue" />
        <circle cx="352" cy="20" r="3.8" class="ochre" />
        <circle cx="363" cy="183" r="5.3" class="blue" />
      </>
    )}
  </svg>
</span>

<style>
  .network-accent {
    --network-line: var(--sage);
    --network-node: var(--sage-deep);
    /* Offset centered editorial frames by their full margin to the page edge. */
    --frame-edge: max(var(--gutter), (100cqi - var(--editorial-max)) / 2);
    position: absolute;
    inset-inline-end: -0.25rem;
    width: min(38vw, 34rem);
    pointer-events: none;
    opacity: 0.72;
    display: none;
  }

  .network-accent svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    pointer-events: none;
  }

  .edges { fill: none; stroke: var(--network-line); stroke-width: 1.75;
    stroke-linecap: round; }
  .edges--wide { stroke-width: 2.7; vector-effect: non-scaling-stroke; }
  .sage { fill: var(--network-node); }
  .ochre { fill: var(--ochre); }
  .blue { fill: var(--diagram-blue); }
  .ring { fill: var(--cream); stroke: var(--network-line); stroke-width: 1.75; }

  .network-accent--services-intro,
  .network-accent--roadmap,
  .network-accent--work {
    inset-inline-end: calc(-1 * var(--frame-edge) - 0.25rem);
  }

  .network-accent--heading { inset-block-start: 0; width: min(21vw, 19rem); opacity: 0.66; }
  .network-accent--article { inset-block-start: 3rem; width: min(17vw, 18rem); opacity: 0.66; }
  .network-accent--services-intro { inset-block-start: -0.65rem; width: min(35vw, 33rem); }
  .network-accent--manifesto { inset-block-start: clamp(6rem, 11vw, 10rem); width: min(40vw, 36rem); }
  .network-accent--work { inset-block-start: -1.1rem; width: min(39vw, 36rem); }
  .network-accent--contact { inset-block-start: -0.25rem; width: min(35vw, 32rem); }
  .network-accent--roadmap { inset-block-start: -2.1rem; width: min(20vw, 19rem); }

  .network-accent--home-field {
    display: block;
    width: calc(100% - var(--gutter));
    max-width: 31rem;
    margin-inline-start: auto;
    margin-block: -0.6rem -1.5rem;
    position: relative;
    inset-inline-end: 0;
    z-index: 1;
    opacity: 0.93;
  }

  .network-accent--feature,
  .network-accent--footer {
    --network-line: var(--diagram-soft);
    --network-node: var(--diagram-soft);
    opacity: 0.78;
  }

  .network-accent--feature { inset-block-end: -2rem; width: min(30vw, 28rem); }
  .network-accent--footer { inset-block-end: -0.4rem; width: min(19vw, 17rem); }
  :is(.network-accent--feature, .network-accent--footer) .ring { fill: var(--sage-deep); }

  @media (min-width: 55rem) {
    .network-accent--home-field {
      position: absolute;
      width: min(53vw, 57rem);
      max-width: none;
      inset-block-end: 0.2rem;
      margin: 0;
    }
  }

  @media (min-width: 62rem) {
    .network-accent--heading,
    .network-accent--services-intro,
    .network-accent--manifesto,
    .network-accent--work { display: block; }
  }

  @media (min-width: 75rem) {
    .network-accent--article,
    .network-accent--roadmap,
    .network-accent--contact,
    .network-accent--feature,
    .network-accent--footer { display: block; }
  }
</style>
