---
const clusters = [
  { color: '#b9c9b4', points: [[43, 119, 4], [76, 82, 6], [113, 103, 3], [89, 140, 8], [49, 165, 5], [135, 149, 5]] },
  { color: '#c79655', points: [[89, 247, 4], [133, 220, 6], [164, 238, 3], [149, 273, 7], [107, 282, 4], [184, 201, 4]] },
  { color: '#95acbb', points: [[169, 57, 4], [205, 39, 5], [237, 65, 7], [208, 88, 4], [166, 99, 5], [263, 110, 4]] },
  { color: '#b9c9b4', points: [[221, 168, 4], [256, 141, 5], [309, 151, 8], [270, 192, 5], [220, 212, 4], [344, 193, 5]] },
  { color: '#c79655', points: [[370, 95, 3], [403, 62, 5], [453, 79, 4], [417, 118, 8], [378, 141, 4], [480, 123, 5]] },
  { color: '#95acbb', points: [[388, 238, 5], [437, 210, 7], [482, 222, 4], [460, 268, 6], [412, 277, 4], [514, 262, 4]] },
];
const clusterEdges = [[0, 1], [0, 3], [1, 2], [1, 3], [2, 3], [2, 5], [3, 4], [3, 5], [0, 4], [4, 5]];
const dust = Array.from({ length: 78 }, (_, i) => ({
  x: 24 + (i * 97 + i * i * 13) % 508,
  y: 19 + (i * 67 + i * i * 7) % 292,
  radius: 0.7 + (i % 4) * 0.25,
}));
---
<svg class="systems-graphic" viewBox="0 0 560 328" aria-hidden="true" focusable="false">
  <rect width="560" height="328" fill="var(--sage-deep)" />
  <g fill="var(--diagram-soft)" opacity=".31">
    {dust.map(({ x, y, radius }) => <circle cx={x} cy={y} r={radius} />)}
  </g>
  <g fill="none" stroke="var(--diagram-soft)" stroke-width="1" opacity=".52">
    <path d="M113 103Q151 65 166 99T221 168M135 149Q178 155 221 168M184 201Q193 175 221 168M166 238Q204 266 270 192M263 110Q294 95 309 151M309 151Q336 111 370 95M344 193Q364 170 378 141M344 193Q355 235 388 238M417 118Q457 162 437 210M480 123Q528 149 482 222"/>
  </g>
  <path d="M89 140Q152 151 221 168T309 151Q354 125 417 118Q471 109 480 123" fill="none" stroke="var(--ochre)" stroke-width="1.55" opacity=".85"/>
  {clusters.map(({ color, points }) => (
    <g stroke={color}>
      {clusterEdges.map(([a, b]) => <line x1={points[a][0]} y1={points[a][1]} x2={points[b][0]} y2={points[b][1]} opacity=".54" />)}
      {points.map(([x, y, radius], index) => <circle cx={x} cy={y} r={radius} fill={index % 3 === 2 ? 'var(--sage-deep)' : color} />)}
    </g>
  ))}
  <circle cx="309" cy="151" r="17" fill="none" stroke="var(--ochre)" stroke-dasharray="2 4" opacity=".85"/>
</svg>
