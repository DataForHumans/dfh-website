---
const clusters = [
  { color: '#5a7a5e', points: [[43, 119, 4], [76, 82, 6], [113, 103, 3], [89, 140, 8], [49, 165, 5], [135, 149, 5]] },
  { color: '#a66e2d', points: [[89, 247, 4], [133, 220, 6], [164, 238, 3], [149, 273, 7], [107, 282, 4], [184, 201, 4]] },
  { color: '#5c7988', points: [[169, 57, 4], [205, 39, 5], [237, 65, 7], [208, 88, 4], [166, 99, 5], [263, 110, 4]] },
  { color: '#5a7a5e', points: [[221, 168, 4], [256, 141, 5], [309, 151, 8], [270, 192, 5], [220, 212, 4], [344, 193, 5]] },
  { color: '#a66e2d', points: [[370, 95, 3], [403, 62, 5], [453, 79, 4], [417, 118, 8], [378, 141, 4], [480, 123, 5]] },
  { color: '#5c7988', points: [[388, 238, 5], [437, 210, 7], [482, 222, 4], [460, 268, 6], [412, 277, 4], [514, 262, 4]] },
];
const clusterEdges = [[0, 1], [0, 3], [1, 2], [1, 3], [2, 3], [2, 5], [3, 4], [3, 5], [0, 4], [4, 5]];
const dust = Array.from({ length: 128 }, (_, i) => ({
  x: 24 + (i * 97 + i * i * 13) % 508,
  y: 19 + (i * 67 + i * i * 7) % 292,
  radius: 0.9 + (i % 5) * 0.35,
}));
---
<svg class="systems-graphic" viewBox="0 0 560 328" aria-hidden="true" focusable="false">
  <g opacity=".42">
    {dust.map(({ x, y, radius }, i) => <circle cx={x} cy={y} r={radius} fill={clusters[i % clusters.length].color} />)}
  </g>
  <g fill="none" stroke="var(--sage-text)" stroke-width="1.15" opacity=".57">
    <path d="M113 103Q151 65 166 99T221 168M135 149Q178 155 221 168M184 201Q193 175 221 168M166 238Q204 266 270 192M263 110Q294 95 309 151M309 151Q336 111 370 95M344 193Q364 170 378 141M344 193Q355 235 388 238M417 118Q457 162 437 210M480 123Q528 149 482 222"/>
  </g>
  <path d="M89 140Q152 151 221 168T309 151Q354 125 417 118Q471 109 480 123" fill="none" stroke="var(--ochre-text)" stroke-width="1.7" opacity=".85"/>
  {clusters.map(({ color, points }) => (
    <g stroke={color}>
      {clusterEdges.map(([a, b]) => <line x1={points[a][0]} y1={points[a][1]} x2={points[b][0]} y2={points[b][1]} opacity=".68" />)}
      {points.map(([x, y, radius], index) => <circle cx={x} cy={y} r={radius * 1.16} fill={index % 3 === 2 ? 'var(--cream)' : color} />)}
    </g>
  ))}
  <g fill="none" stroke="var(--sage-text)" opacity=".58">
    <path d="M49 165Q68 182 105 180T135 149M237 65Q267 37 298 72T309 151M378 141Q390 169 432 157T480 123M412 277Q373 300 326 274T270 192" />
    <circle cx="105" cy="180" r="3" />
    <circle cx="298" cy="72" r="4" />
    <circle cx="432" cy="157" r="3.5" />
    <circle cx="326" cy="274" r="5" />
  </g>
  <circle cx="309" cy="151" r="17" fill="none" stroke="var(--ochre-text)" stroke-dasharray="2 4" opacity=".85"/>
</svg>
