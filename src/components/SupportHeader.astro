---
import '../styles/core.css';
import '../styles/support.css';

interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow } = Astro.props;
---

<header class="editorial-frame core-intro">
  {eyebrow && <p class="eyebrow mono">{eyebrow}</p>}
  <h1>{title}</h1>
  <slot />
</header>
