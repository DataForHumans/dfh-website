---
/** Shared body of /notes/ and the type pages /notes/<type>/. */
import SupportHeader from './SupportHeader.astro';
import NoteList from './NoteList.astro';
import { NOTE_TYPES, type NoteType } from '../data/site';
import type { Note } from '../lib/content';

interface Props {
  title: string;
  notes: Note[];
  /** Types that have at least one note. Only these get a filter link. */
  types: NoteType[];
  current?: NoteType;
}
const { title, notes, types, current } = Astro.props;
---

<SupportHeader title={title}>
  <p class="lede">
    {current === 'project' && 'What teams wanted to learn, what their records showed and how they used what they found.'}
    {current === 'article' && 'Practical ways to make sense of data and AI in your own work.'}
    {current === 'news' && 'Updates and coverage about Data for Humans and our work.'}
    {!current && 'What we’re learning from projects and how you can make sense of data and AI in your own work.'}
  </p>
</SupportHeader>

<div class="editorial-frame notes-index">
  <div class="notes-index__tools">
    {types.length > 0 && (
      <nav aria-label="Filter notes by type">
        <ul class="notes-index__filters" role="list">
          <li><a href="/notes/" aria-current={!current ? 'page' : undefined}>All</a></li>
          {types.map((type) => (
            <li>
              <a href={`/notes/${type}/`} aria-current={current === type ? 'page' : undefined}>
                {NOTE_TYPES[type].plural}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <a class="notes-index__rss" href="/notes/rss.xml">RSS feed</a>
  </div>

  {notes.length > 0 ? (
    <NoteList notes={notes} />
  ) : (
    <div class="notes-index__empty">
      <p>{current ? 'No notes in this category yet.' : 'The first notes are coming soon.'}</p>
      {current && <a href="/notes/">Browse all notes</a>}
    </div>
  )}
</div>
