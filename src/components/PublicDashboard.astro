---
import { Image, getImage } from 'astro:assets';
import dashboard from '../assets/work/any-path-home-dashboard.png';

interface Props { preview?: boolean }
const { preview = false } = Astro.props;
const full = preview ? undefined : await getImage({ src: dashboard, format: 'png' });
---
<figure>
  <Image src={dashboard} alt="Public dashboard showing how participating Any Path Home providers track homelessness, entries and exits, and housing outcomes for single adults." width={preview ? 800 : 1100} format="webp" quality={90} />
  <figcaption>Public Any Path Home community dashboard, October 2026 reporting. {full && <a href={full.src}>Enlarge dashboard</a>}</figcaption>
</figure>

<style>
  figure { margin: 0; }
  img { width: 100%; height: auto; border: 1px solid var(--rule); }
  figcaption { margin-top: 0.45rem; font-size: 0.9rem; line-height: 1.4; }
  a { display: inline-flex; align-items: center; min-height: var(--touch-target); }
</style>
