---
import { Image } from 'astro:assets';
import mark from '../assets/brand/dfh-mark.png';
import { opportunities, phases, quadrants, sources, sourcePaths, systems } from '../data/roadmap';
import '../styles/roadmap.css';
---

<section class="sample-report" aria-labelledby="sample-roadmap-title">
  <header class="sample-report__header">
    <Image src={mark} alt="" width={42} height={42} />
    <div>
      <p class="mono">Illustrative sample deliverable</p>
      <h3 id="sample-roadmap-title">Community Resource Network</h3>
      <p>A fictional organization, with sample systems and recommendations.</p>
    </div>
  </header>

  <details class="sample-report__disclosure">
    <summary>Explore the systems map, priorities and sequence</summary>
    <div class="roadmap-exhibit" data-roadmap-exhibit>
      <p class="roadmap-exhibit__hint">Focus or point to preview relationships. Select to keep them highlighted.</p>
      <nav class="roadmap-exhibit__jump" aria-label="Roadmap views">
        <a href="#roadmap-systems">Systems</a>
        <a href="#roadmap-matrix">Matrix</a>
        <a href="#roadmap-sequence">Sequence</a>
        <a href="#roadmap-selection-details">Selection details</a>
      </nav>
      <p class="visually-hidden" role="status"></p>

      <div class="roadmap-exhibit__panels">
        <section class="roadmap-panel roadmap-panel--systems" aria-labelledby="roadmap-systems">
          <h4 id="roadmap-systems" tabindex="-1"><span aria-hidden="true">01</span> Systems map</h4>
          <p class="visually-hidden">Program records, the donor CRM, and the volunteer system feed manual reconciliation before grant reporting.</p>
          <div class="roadmap-sources">
            {sources.map((id) => <button type="button" data-system={id} disabled>{systems[id].name}</button>)}
          </div>
          <svg class="roadmap-connectors" viewBox="0 0 300 42" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            {sources.map((id, index) => <path d={sourcePaths[index]} data-from={id} data-to="reconciliation" />)}
          </svg>
          <button type="button" class="roadmap-system-wide" data-system="reconciliation" disabled>{systems.reconciliation.name}</button>
          <svg class="roadmap-connectors roadmap-connectors--short" viewBox="0 0 300 27" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M150 0v25m-5-5 5 5 5-5" data-from="reconciliation" data-to="grants" />
          </svg>
          <button type="button" class="roadmap-system-wide" data-system="grants" disabled>{systems.grants.name}</button>
        </section>

        <section class="roadmap-panel" aria-labelledby="roadmap-matrix">
          <h4 id="roadmap-matrix" tabindex="-1"><span aria-hidden="true">02</span> Prioritization matrix</h4>
          <p class="roadmap-axis">Expected value <span>Low to high ↑</span></p>
          <div class="roadmap-matrix">
            {quadrants.map((quadrant) => (
              <div class="roadmap-quadrant">
                <p>{quadrant.name}</p>
                <div>
                  {opportunities.filter(({ effort, value }) => effort === quadrant.effort && value === quadrant.value).map((item) => (
                    <button
                      type="button"
                      class="roadmap-marker"
                      data-opportunity={item.id}
                      aria-label={`Opportunity ${item.id}: ${item.name}, ${quadrant.name}`}
                      disabled
                    ><span>{item.id}</span></button>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <p class="roadmap-axis">Implementation effort <span>Low to high →</span></p>
          <p class="roadmap-panel__note">Illustrative placements, without measured scores.</p>
        </section>

        <section class="roadmap-panel" aria-labelledby="roadmap-sequence">
          <h4 id="roadmap-sequence" tabindex="-1"><span aria-hidden="true">03</span> Implementation sequence</h4>
          {phases.map((phase) => (
            <div class="roadmap-phase">
              <h5 class="mono">{phase}</h5>
              <ul role="list">
                {opportunities.filter((item) => item.phase === phase).map((item) => (
                  <li>
                    <button type="button" class="roadmap-step" data-opportunity={item.id} disabled>
                      <span class="roadmap-step__number" aria-hidden="true">{item.id}</span>
                      {item.name}
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      </div>

      <div class="roadmap-exhibit__detail" id="roadmap-selection-details" tabindex="-1">
        <div>
          <p class="mono" data-detail-label>Explore the roadmap</p>
          <h4 data-detail-title>Connect systems to decisions</h4>
          <p data-detail-copy>Follow the numbered opportunities from the effort and value matrix into the implementation sequence.</p>
        </div>
        <button type="button" class="button roadmap-exhibit__reset" data-reset hidden>Clear selection</button>
      </div>
      <p class="roadmap-exhibit__first"><span class="mono">First action</span> Assign a reporting owner and agree on the definitions the team will use.</p>
      <div class="roadmap-exhibit__fallback">
        <p>The numbers connect the matrix to the sequence. These are the related systems for each opportunity.</p>
        <ol>
          {opportunities.map((item) => (
            <li>{item.name}: {item.systems.map((id) => systems[id].name).join(', ')}.</li>
          ))}
        </ol>
      </div>
    </div>
  </details>
</section>

<script>
  import '../scripts/roadmap';
</script>
