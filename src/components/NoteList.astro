---
import { formatDate, isoDate } from '../lib/dates';
import { getPerson, type Note } from '../lib/content';
import { NOTE_TYPES } from '../data/site';

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
const items = await Promise.all(notes.map(async (note) => ({ note, author: await getPerson(note.data.author) })));
---

<ol class="notes-list" role="list">
  {items.map(({ note, author }) => (
    <li class="notes-list__row">
      <time class="mono" datetime={isoDate(note.data.date)}>{formatDate(note.data.date)}</time>
      <div>
        <h2><a href={`/notes/${note.id}/`}>{note.data.title}</a></h2>
        <p class="entry__meta mono">
          {NOTE_TYPES[note.data.type].label} · {author.data.knownAs ?? author.data.name}
        </p>
        <p class="notes-list__summary">{note.data.summary}</p>
      </div>
    </li>
  ))}
</ol>
